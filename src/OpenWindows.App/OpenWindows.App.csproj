<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>OpenWindows</AssemblyName>
    <RootNamespace>OpenWindows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>0.9.0</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <StartupObject>OpenWindows.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.2" />
    <PackageReference Include="System.Collections.Immutable" Version="9.0.1" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.1" />
    <PackageReference Include="System.Reflection.Metadata" Version="9.0.1" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
    <PackageReference Include="TaskScheduler" Version="2.12.2" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <Target Name="CopyWindowsAppRuntimeInsightsResource" AfterTargets="Build" Condition="!Exists('$(OutDir)Microsoft.WindowsAppRuntime.Insights.Resource.dll')">
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;$p = Get-AppxPackage -Name Microsoft.WindowsAppRuntime.2 | Sort-Object Version -Descending | Select-Object -First 1; if ($p) { $s = Join-Path $p.InstallLocation 'Microsoft.WindowsAppRuntime.Insights.Resource.dll'; if (Test-Path -LiteralPath $s) { Copy-Item -LiteralPath $s '$(OutDir)Microsoft.WindowsAppRuntime.Insights.Resource.dll' -Force } }&quot;" ContinueOnError="true" StandardOutputImportance="low" StandardErrorImportance="low" />
  </Target>

</Project>
