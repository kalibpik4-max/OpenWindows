<Page x:Class="OpenWindows.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:OpenWindows.ViewModels"
      xmlns:controls="clr-namespace:OpenWindows.Controls"
      Title="Dashboard"
      Background="Transparent">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>
    <Grid Margin="28,12,28,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,28">
            <StackPanel>
                <Grid>
                    <StackPanel>
                        <ui:TextBlock FontTypography="Title" Text="Dashboard" />
                        <ui:TextBlock FontTypography="Body" Appearance="Secondary" Margin="0,4,0,20" TextWrapping="Wrap"
                                      Text="Your PC at a glance - live numbers while monitoring runs, plus what is safe to close." />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,8,0,0" Visibility="{Binding IsMonitoring, Converter={StaticResource BoolToVis}}">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource AppSuccessBrush}" VerticalAlignment="Center">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="1.0" To="0.25" Duration="0:0:1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <TextBlock Text="LIVE" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppSuccessBrush}" />
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                        <StackPanel>
                            <ui:TextBlock FontTypography="Caption" Appearance="Secondary" Text="CPU" />
                            <TextBlock Text="{Binding CpuPercentText}" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CpuLevel}" Value="Medium">
                                                <Setter Property="Foreground" Value="{DynamicResource AppCautionBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CpuLevel}" Value="High">
                                                <Setter Property="Foreground" Value="{DynamicResource AppCriticalBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ProgressBar Value="{Binding CpuPercent, Mode=OneWay}" Maximum="100" Height="4" Margin="0,10,0,6" />
                            <controls:SparklineChart Values="{Binding CpuHistory}" Height="28"
                                                     Stroke="{DynamicResource AppAccentBrush}" />
                            <ui:TextBlock FontTypography="Caption" Appearance="Tertiary" Margin="0,6,0,0"
                                          Text="{Binding CpuName}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                        <StackPanel>
                            <ui:TextBlock FontTypography="Caption" Appearance="Secondary" Text="Memory" />
                            <TextBlock Text="{Binding RamText}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RamLevel}" Value="Medium">
                                                <Setter Property="Foreground" Value="{DynamicResource AppCautionBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RamLevel}" Value="High">
                                                <Setter Property="Foreground" Value="{DynamicResource AppCriticalBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ProgressBar Value="{Binding RamPercent, Mode=OneWay}" Maximum="100" Height="4" Margin="0,10,0,6" />
                            <controls:SparklineChart Values="{Binding RamHistory}" Height="28"
                                                     Stroke="{DynamicResource AppSuccessBrush}" />
                            <ui:TextBlock FontTypography="Caption" Appearance="Tertiary" Margin="0,6,0,0"
                                          Text="RAM in use" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                        <StackPanel>
                            <ui:TextBlock FontTypography="Caption" Appearance="Secondary" Text="Disk C:" />
                            <TextBlock Text="{Binding DiskText}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DiskLevel}" Value="Medium">
                                                <Setter Property="Foreground" Value="{DynamicResource AppCautionBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DiskLevel}" Value="High">
                                                <Setter Property="Foreground" Value="{DynamicResource AppCriticalBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ProgressBar Value="{Binding DiskPercent, Mode=OneWay}" Maximum="100" Height="4" Margin="0,10,0,14" />
                            <ui:TextBlock FontTypography="Caption" Appearance="Tertiary" Text="Space used" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <ui:TextBlock FontTypography="Caption" Appearance="Secondary" Text="System" />
                            <ui:TextBlock FontTypography="BodyStrong" Text="{Binding OsDetail}" Margin="0,4,0,0"
                                          TextWrapping="Wrap" />
                            <ui:TextBlock FontTypography="Caption" Appearance="Tertiary" Text="{Binding CpuDetail}"
                                          Margin="0,6,0,0" TextWrapping="Wrap" />
                            <ui:TextBlock FontTypography="Caption" Appearance="Tertiary" Text="{Binding UptimeDetail}"
                                          Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0"
                        Visibility="{Binding HasUnused, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Warning24" FontSize="18" Margin="0,0,8,0"
                                               Foreground="{DynamicResource AppCautionBrush}" VerticalAlignment="Center" />
                                <ui:TextBlock FontTypography="BodyStrong" Text="Running in the background - not in use" />
                            </StackPanel>
                            <ui:TextBlock FontTypography="Caption" Appearance="Secondary" Margin="0,4,0,10"
                                          TextWrapping="Wrap" Text="{Binding UnusedSummaryText}" />
                            <ItemsControl ItemsSource="{Binding UnusedProcesses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ProcessItemVM}">
                                        <Grid Margin="0,3,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Grid.Column="0">
                                                <Ellipse Width="6" Height="6" Fill="{DynamicResource AppCautionBrush}"
                                                         VerticalAlignment="Center" Margin="2,0,10,0" />
                                                <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding CpuText}" FontSize="12.5"
                                                       TextAlignment="Right" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="2" Text="{Binding RamText}" FontSize="12.5"
                                                       TextAlignment="Right" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <ui:Button Grid.Column="1" Appearance="Primary" VerticalAlignment="Center"
                                   Content="Review and close" Command="{Binding OpenProcessesCommand}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="AppsList24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </Grid>
                </Border>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                        <StackPanel>
                            <ui:TextBlock FontTypography="Caption" Appearance="Secondary"
                                          Text="Performance health" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <ui:TextBlock FontTypography="Display" Text="{Binding HealthScoreText}" />
                                <ui:TextBlock FontTypography="Subtitle" Text="{Binding HealthLabel}"
                                              Margin="14,0,0,8" VerticalAlignment="Bottom" />
                            </StackPanel>
                            <TextBlock Text="{Binding HealthDescription}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding LastScanText}" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" />
                            <ui:Button Margin="0,14,0,0" HorizontalAlignment="Left" Appearance="Primary"
                                       Content="Scan now" Command="{Binding ScanNowCommand}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Search24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <ui:TextBlock FontTypography="Caption" Appearance="Secondary" Text="Quick actions" />
                            <ui:Button Margin="0,12,0,0" HorizontalAlignment="Stretch"
                                       HorizontalContentAlignment="Left" Content="{Binding MonitorButtonText}"
                                       Command="{Binding OpenMonitorCommand}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Play24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                       HorizontalContentAlignment="Left" Content="Open processes"
                                       Command="{Binding OpenProcessesCommand}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="AppsList24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                       HorizontalContentAlignment="Left" Content="Undo last changes"
                                       Command="{Binding UndoLastCommand}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="ArrowUndo24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                       HorizontalContentAlignment="Left" Content="View history"
                                       Command="{Binding OpenHistoryCommand}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="History24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="Top findings" />
                        <ui:TextBlock FontTypography="Caption" Appearance="Tertiary" Margin="0,2,0,0"
                                      Text="From the most recent scan. Run Scan now to refresh." />

                        <TextBlock Text="No scan yet - run one to see what this PC can improve."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,12,0,0" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasRecentFindings}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding RecentFindings}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FindingItemVM}">
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill"
                                                            Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSafe}" Value="True">
                                                            <Setter Property="Fill"
                                                                    Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsCaution}" Value="True">
                                                            <Setter Property="Fill"
                                                                    Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="12"
                                                       Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding CategoryLabel}" FontSize="11"
                                                   Margin="12,2,0,0" VerticalAlignment="Top"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
