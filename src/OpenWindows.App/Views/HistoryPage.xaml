<Page x:Class="OpenWindows.Views.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:OpenWindows.ViewModels"
      Title="History"
      Background="Transparent">
    <Grid Margin="24,12,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <ui:TextBlock FontTypography="Title" Text="History" />
            <ui:TextBlock FontTypography="Body" Appearance="Secondary" Margin="0,4,0,12" TextWrapping="Wrap"
                          Text="Every apply session is saved as a backup so changes can be undone. Undo restores everything in that session." />

            <Border Style="{StaticResource CardStyle}" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock FontTypography="Caption" Appearance="Secondary" VerticalAlignment="Center"
                                  TextWrapping="Wrap" Text="{Binding StatusText}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:Button Content="Open backups folder" Command="{Binding OpenBackupsFolderCommand}"
                                   Margin="0,0,8,0" />
                        <ui:Button Content="Refresh" Command="{Binding RefreshCommand}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowSync24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <ListView Grid.Row="1" Margin="0,14,0,0" ItemsSource="{Binding Sessions}" Background="Transparent"
                  BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="10,6" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:BackupSessionVM}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DateText}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Border Margin="10,0,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource BadgeStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsReverted}" Value="True">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsReverted}" Value="False">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReverted}" Value="False">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding FileName}" FontSize="11" Margin="0,3,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{Binding SummaryText}" FontSize="12" Margin="0,3,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Expander Header="Details" Margin="0,8,0,0">
                                <ItemsControl ItemsSource="{Binding Entries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:BackupEntryVM}">
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12"
                                                       Margin="4,3,0,0"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
                            <ui:Button Content="Undo this session"
                                       Command="{Binding DataContext.UndoSessionCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                       CommandParameter="{Binding}">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsReverted}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="ArrowUndo24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
