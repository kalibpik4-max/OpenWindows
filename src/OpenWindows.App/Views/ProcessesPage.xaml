<Page x:Class="OpenWindows.Views.ProcessesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:OpenWindows.ViewModels"
      Title="Processes"
      Background="Transparent">
    <Grid Margin="28,12,28,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <ui:TextBlock FontTypography="Title" Text="Processes" />
                <ui:TextBlock FontTypography="Body" Appearance="Secondary" Margin="0,4,0,16" TextWrapping="Wrap"
                              Text="Everything running right now. Apps that are active in the background but not in use are highlighted - close them to free CPU and memory." />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0">
                <Ellipse Width="8" Height="8" Fill="{DynamicResource AppSuccessBrush}" VerticalAlignment="Center">
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="1.0" To="0.25" Duration="0:0:1" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <TextBlock Text="LIVE - refreshes every 3 seconds" FontSize="12" Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AppTextSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding SummaryText}" TextWrapping="Wrap" FontSize="13"
                           VerticalAlignment="Center" Margin="0,0,16,0"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="Select unused" Command="{Binding SelectUnusedCommand}"
                               Margin="0,0,8,0" />
                    <ui:Button Content="Clear" Command="{Binding ClearSelectionCommand}" Margin="0,0,8,0" />
                    <ui:Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0"
                               ToolTip="Refresh now">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowSync24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Content="End all unused" Appearance="Caution"
                               Command="{Binding EndUnusedCommand}" Margin="0,0,8,0">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Delete24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Appearance="Primary" Command="{Binding EndSelectedCommand}"
                               AutomationProperties.Name="{Binding EndSelectedText}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Power24" FontSize="16" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding EndSelectedText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="10,8" Margin="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="10,0,10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="118" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="84" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="App / process" FontSize="12"
                               Foreground="{DynamicResource AppTextTertiaryBrush}" />
                    <TextBlock Grid.Column="2" Text="Status" FontSize="12"
                               Foreground="{DynamicResource AppTextTertiaryBrush}" />
                    <TextBlock Grid.Column="3" Text="CPU" FontSize="12" TextAlignment="Right"
                               Foreground="{DynamicResource AppTextTertiaryBrush}" />
                    <TextBlock Grid.Column="4" Text="Memory" FontSize="12" TextAlignment="Right"
                               Foreground="{DynamicResource AppTextTertiaryBrush}" />
                </Grid>

                <ListView Grid.Row="1" ItemsSource="{Binding View}" Background="Transparent" BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="8,5" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ProcessItemVM}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="118" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="84" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          IsEnabled="{Binding CanSelect}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <Border CornerRadius="4" Padding="5,0" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource AppCautionSoftBrush}" />
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUnused}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="NOT IN USE" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppCautionBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                               Margin="0,1,0,0"
                                               Foreground="{DynamicResource AppTextTertiaryBrush}" />
                                </StackPanel>

                                <Border Grid.Column="2" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource StatusPillStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUnused}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AppCautionSoftBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11.5">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding StatusText}" />
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusText}" Value="In use">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource AppSuccessBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsUnused}" Value="True">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource AppCautionBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <TextBlock Grid.Column="3" Text="{Binding CpuText}" FontSize="13" FontWeight="SemiBold"
                                           TextAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CpuLevel}" Value="Medium">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource AppCautionBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CpuLevel}" Value="High">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource AppCriticalBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Grid.Column="4" Text="{Binding RamText}" FontSize="13" TextAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                <ui:Button Grid.Column="5" Appearance="Secondary" FontSize="12" Padding="10,4"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           ToolTip="End this process"
                                           AutomationProperties.Name="End"
                                           Command="{Binding DataContext.EndOneCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                           CommandParameter="{Binding}"
                                           IsEnabled="{Binding CanSelect}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Power24" FontSize="14" Margin="0,0,4,0" />
                                        <TextBlock Text="End" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ui:Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
