<Page x:Class="OpenWindows.Views.MonitorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:OpenWindows.Controls"
      xmlns:vm="clr-namespace:OpenWindows.ViewModels"
      Title="Monitor"
      Background="Transparent">
    <Grid Margin="24,12,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <ui:TextBlock FontTypography="Title" Text="Monitor" />
            <ui:TextBlock FontTypography="Body" Appearance="Secondary" Margin="0,4,0,0" TextWrapping="Wrap"
                          Text="Live CPU, memory and disk usage, plus the processes using the most of your machine." />

            <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:Button Appearance="Primary" Content="{Binding MonitoringButtonText}"
                               Command="{Binding ToggleMonitoringCommand}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Play24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0"
                                VerticalAlignment="Center">
                        <CheckBox Content="CPU alerts" IsChecked="{Binding AlertsEnabled, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                        <Slider Width="160" Minimum="50" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                Value="{Binding AlertThreshold, Mode=TwoWay}" Margin="16,0,0,0"
                                VerticalAlignment="Center" />
                        <ui:TextBlock FontTypography="Caption" Appearance="Secondary" Margin="10,0,0,0"
                                      VerticalAlignment="Center" Text="{Binding AlertThresholdText}" />
                    </StackPanel>
                    <ui:Button Grid.Column="2" Content="Refresh power plan"
                               Command="{Binding RefreshPowerPlanCommand}" />
                </Grid>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                <StackPanel>
                    <ui:TextBlock FontTypography="Caption" Appearance="Secondary" Text="CPU" />
                    <ui:TextBlock FontTypography="Subtitle" Text="{Binding CpuText}" Margin="0,2,0,8" />
                    <controls:SparklineChart Values="{Binding CpuValues}" Height="56" MinValue="0" MaxValue="100" />
                </StackPanel>
            </Border>

            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                <StackPanel>
                    <ui:TextBlock FontTypography="Caption" Appearance="Secondary" Text="Memory" />
                    <ui:TextBlock FontTypography="Subtitle" Text="{Binding RamText}" Margin="0,2,0,8" />
                    <controls:SparklineChart Values="{Binding RamValues}" Height="56" MinValue="0" MaxValue="100" />
                </StackPanel>
            </Border>

            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <ui:TextBlock FontTypography="Caption" Appearance="Secondary" Text="Disk C:" />
                    <ui:TextBlock FontTypography="Subtitle" Text="{Binding DiskText}" Margin="0,2,0,8" />
                    <controls:SparklineChart Values="{Binding DiskValues}" Height="56" MinValue="0" MaxValue="100" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource CardStyle}" Margin="0,14,0,0"
                    Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="8,4,8,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock FontTypography="BodyStrong" Text="Top processes" />
                        <ui:TextBlock Grid.Column="2" FontTypography="Caption" Appearance="Secondary" Text="CPU"
                                       HorizontalAlignment="Right" />
                        <ui:TextBlock Grid.Column="3" FontTypography="Caption" Appearance="Secondary" Text="Memory"
                                       HorizontalAlignment="Right" />
                    </Grid>
                    <ListView x:Name="ProcessesList" Grid.Row="1" ItemsSource="{Binding Processes}"
                              Background="Transparent" BorderThickness="0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="8,3" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ProcessRowVM}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="76" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Border Grid.Column="1" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource StatusPillStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBackground}" Value="True">
                                                        <Setter Property="Background"
                                                                Value="{DynamicResource AppBadgeBackgroundBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11.5">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding StatusText}" />
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource AppSuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBackground}" Value="True">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding CpuText}" FontWeight="SemiBold"
                                               HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CpuLevel}" Value="Medium">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource AppCautionBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CpuLevel}" Value="High">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource AppCriticalBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="3" Text="{Binding RamText}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <ui:Button Grid.Column="4" Appearance="Secondary" FontSize="12" Padding="10,4"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               ToolTip="End this process"
                                               AutomationProperties.Name="End"
                                               IsEnabled="{Binding CanEnd}"
                                               Command="{Binding DataContext.EndProcessCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                               CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Power24" FontSize="14" Margin="0,0,4,0" />
                                            <TextBlock Text="End" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ui:Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="0,0,0,20" IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=ProcessesList}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ui:ProgressRing IsIndeterminate="True" Width="26" Height="26" HorizontalAlignment="Center">
                            <ui:ProgressRing.Style>
                                <Style TargetType="ui:ProgressRing">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMonitoring}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:ProgressRing.Style>
                        </ui:ProgressRing>
                        <ui:TextBlock FontTypography="Caption" Appearance="Secondary" Margin="0,10,0,0"
                                      HorizontalAlignment="Center">
                            <ui:TextBlock.Style>
                                <Style TargetType="ui:TextBlock">
                                    <Setter Property="Text" Value="Gathering process data - the first sample lands in a moment." />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMonitoring}" Value="False">
                                            <Setter Property="Text"
                                                    Value="Monitoring is paused. Click Start monitoring to see the top processes." />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:TextBlock.Style>
                        </ui:TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
