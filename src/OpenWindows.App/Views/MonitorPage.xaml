<Page x:Class="OpenWindows.Views.MonitorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:OpenWindows.Controls"
      xmlns:vm="clr-namespace:OpenWindows.ViewModels"
      Title="Monitor"
      Background="Transparent">
    <Grid Margin="24,12,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <ui:TextBlock FontTypography="Title" Text="Monitor" />
            <ui:TextBlock FontTypography="Body" Appearance="Secondary" Margin="0,4,0,0" TextWrapping="Wrap"
                          Text="Live CPU, memory and disk usage, plus the processes using the most of your machine." />

            <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:Button Appearance="Primary" Content="{Binding MonitoringButtonText}"
                               Command="{Binding ToggleMonitoringCommand}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Play24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0"
                                VerticalAlignment="Center">
                        <CheckBox Content="CPU alerts" IsChecked="{Binding AlertsEnabled, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                        <Slider Width="160" Minimum="50" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                Value="{Binding AlertThreshold, Mode=TwoWay}" Margin="16,0,0,0"
                                VerticalAlignment="Center" />
                        <ui:TextBlock FontTypography="Caption" Appearance="Secondary" Margin="10,0,0,0"
                                      VerticalAlignment="Center" Text="{Binding AlertThresholdText}" />
                    </StackPanel>
                    <ui:Button Grid.Column="2" Content="Refresh power plan"
                               Command="{Binding RefreshPowerPlanCommand}" />
                </Grid>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                <StackPanel>
                    <ui:TextBlock FontTypography="Caption" Appearance="Secondary" Text="CPU" />
                    <ui:TextBlock FontTypography="Subtitle" Text="{Binding CpuText}" Margin="0,2,0,8" />
                    <controls:SparklineChart Values="{Binding CpuValues}" Height="56" MinValue="0" MaxValue="100" />
                </StackPanel>
            </Border>

            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                <StackPanel>
                    <ui:TextBlock FontTypography="Caption" Appearance="Secondary" Text="Memory" />
                    <ui:TextBlock FontTypography="Subtitle" Text="{Binding RamText}" Margin="0,2,0,8" />
                    <controls:SparklineChart Values="{Binding RamValues}" Height="56" MinValue="0" MaxValue="100" />
                </StackPanel>
            </Border>

            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <ui:TextBlock FontTypography="Caption" Appearance="Secondary" Text="Disk C:" />
                    <ui:TextBlock FontTypography="Subtitle" Text="{Binding DiskText}" Margin="0,2,0,8" />
                    <controls:SparklineChart Values="{Binding DiskValues}" Height="56" MinValue="0" MaxValue="100" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource CardStyle}" Margin="0,14,0,0"
                    Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="8,4,8,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock FontTypography="BodyStrong" Text="Top processes" />
                        <ui:TextBlock Grid.Column="1" FontTypography="Caption" Appearance="Secondary" Text="CPU"
                                      HorizontalAlignment="Right" />
                        <ui:TextBlock Grid.Column="2" FontTypography="Caption" Appearance="Secondary" Text="RAM (MB)"
                                      HorizontalAlignment="Right" />
                    </Grid>
                    <ListView Grid.Row="1" ItemsSource="{Binding Processes}" Background="Transparent"
                              BorderThickness="0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="8,3" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ProcessRowVM}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding CpuText}" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="{Binding RamText}" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
